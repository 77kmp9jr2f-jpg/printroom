{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Print Companion reviewed Spoolmark handoff v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "source",
    "id",
    "spoolReference",
    "reviewed",
    "label",
    "measurements"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "source": {
      "const": "spoolmark"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{8,128}$"
    },
    "spoolReference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "reviewed": {
      "const": true
    },
    "label": {
      "type": "object",
      "required": [
        "maker",
        "material",
        "color"
      ],
      "properties": {
        "maker": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "material": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "color": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "nozzle": {
          "type": "string",
          "minLength": 0,
          "maxLength": 64
        },
        "bed": {
          "type": "string",
          "minLength": 0,
          "maxLength": 64
        },
        "diameter": {
          "type": "string",
          "minLength": 0,
          "maxLength": 64
        },
        "weight": {
          "type": "string",
          "minLength": 0,
          "maxLength": 64
        },
        "drying": {
          "type": "string",
          "minLength": 0,
          "maxLength": 160
        },
        "notes": {
          "type": "string",
          "minLength": 0,
          "maxLength": 512
        }
      }
    },
    "measurements": {
      "type": "object",
      "required": [
        "diameterMm",
        "densityGcm3",
        "densitySource",
        "initialWeightG",
        "remainingWeightG"
      ],
      "properties": {
        "diameterMm": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10
        },
        "densityGcm3": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 30
        },
        "densitySource": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "initialWeightG": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100000
        },
        "remainingWeightG": {
          "type": "number",
          "minimum": 0,
          "maximum": 100000
        }
      }
    },
    "colorHex": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^#?[A-Fa-f0-9]{6}([A-Fa-f0-9]{2})?$"
    }
  },
  "description": "The service additionally checks remaining mass does not exceed initial mass, combined name/comment length, physical spool uniqueness, and handoff idempotency. Values require operator review; no material density is inferred."
}
